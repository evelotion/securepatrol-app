// SecurePatrol — Skema database (Blok 1)
// PRD: docs/PRD-SecurePatrol.md bagian 8 "Data yang Disimpan"

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Status validasi patroli (Fase 2 anti-kecurangan).
enum StatusScan {
  VALID
  TIDAK_VALID
  BELUM_TERVERIFIKASI
}

/// Status kehadiran terhadap jadwal shift (F4-2).
enum StatusHadir {
  TEPAT_WAKTU
  TELAT
  PULANG_CEPAT
  TIDAK_HADIR
}

/// Role pengguna sesuai PRD bagian 2.
enum Role {
  SUPER_ADMIN
  CHIEF_SECURITY
  DANRU
  SECURITY
}

model User {
  id        String   @id @default(cuid())
  nama      String
  email     String   @unique
  username  String?  @unique
  /// Hash scrypt "salt:hash" — tidak pernah dikirim ke client.
  password  String
  role      Role     @default(SECURITY)
  /// Tim/regu (mis. "Regu A").
  regu      String?
  /// Soft delete: true = aktif, false = dinonaktifkan (tidak pernah hapus permanen).
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions    Session[]
  absensi     Absensi[]
  patroliLogs PatroliLog[]
  auditLogs   AuditLog[]
  fotos       Foto[]
  jadwal      Jadwal[]
  insidenDilaporkan Insiden[] @relation("InsidenPelapor")
  insidenDitangani  Insiden[] @relation("InsidenPenangan")

  @@map("User")
}

model Checkpoint {
  id          String   @id @default(cuid())
  /// Nama titik patroli, mis. "Lobi Utama".
  namaTitik   String   @map("nama_titik")
  /// Kode yang dicetak ke barcode/QR dan ditempel di gedung.
  kodeBarcode String   @unique @map("kode_barcode")
  /// Koordinat titik validasi GPS.
  lat         Decimal? @db.Decimal(10, 7)
  long        Decimal? @db.Decimal(10, 7)
  keterangan  String?
  /// Soft delete.
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  patroliLogs PatroliLog[]
  ruteTitik   RuteTitik[]
  insiden     Insiden[]

  @@map("Checkpoint")
}

model Absensi {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  waktuMasuk DateTime  @map("waktu_masuk")
  waktuKeluar DateTime? @map("waktu_keluar")
  /// Cloudinary public ID (atau base64 legacy sampai migrasi foto dijalankan).
  fotoMasuk  String?   @map("foto_masuk")
  fotoKeluar String?   @map("foto_keluar")
  latMasuk   Decimal?  @db.Decimal(10, 7) @map("lat_masuk")
  longMasuk  Decimal?  @db.Decimal(10, 7) @map("long_masuk")
  latKeluar  Decimal?  @db.Decimal(10, 7) @map("lat_keluar")
  longKeluar Decimal?  @db.Decimal(10, 7) @map("long_keluar")
  /// Jadwal shift yang berlaku saat absen (F4-2), diisi dari Jadwal hari itu.
  shiftId     String?      @map("shift_id")
  statusHadir StatusHadir? @map("status_hadir")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([userId, waktuMasuk])
  @@map("Absensi")
}

model PatroliLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  checkpointId String   @map("checkpoint_id")
  waktu        DateTime @default(now())
  /// Cloudinary public ID (atau base64 legacy sampai migrasi foto dijalankan).
  foto         String?
  lat          Decimal? @db.Decimal(10, 7)
  long         Decimal? @db.Decimal(10, 7)
  /// Status dan alasan validasi patroli (Fase 2).
  status       StatusScan @default(VALID)
  akurasiM     Int?       @map("akurasi_m")
  jarakM       Int?       @map("jarak_m")
  alasan       String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([checkpointId, waktu])
  @@index([userId, waktu])
  @@map("PatroliLog")
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?  @map("user_id")
  /// mis. "LOGIN", "CREATE_USER", "UPDATE_CHECKPOINT", "TOGGLE_USER".
  aksi     String
  tabel    String
  dataLama Json?    @map("data_lama")
  dataBaru Json?    @map("data_baru")
  waktu    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tabel, waktu])
  @@map("AuditLog")
}

/// Percobaan login untuk rate limit (F1-3).
/// `identifier` disimpan dalam huruf kecil (email/username yang ditekan).
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  ip         String
  sukses     Boolean  @default(false)
  waktu      DateTime @default(now())

  @@index([identifier, sukses, waktu])
  @@index([ip, sukses, waktu])
  @@map("LoginAttempt")
}

/// Metadata foto private yang disimpan di Cloudinary.
model Foto {
  id        String   @id @default(cuid())
  key       String   @unique
  mime      String
  ukuran    Int
  userId    String   @map("user_id")
  dibuatPada DateTime @default(now()) @map("dibuat_pada")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dibuatPada])
  @@map("Foto")
}

/// Shift jaga (F4-2). Jam disimpan sebagai "HH:MM" WIB agar tidak bergantung
/// pada zona waktu server; shift malam melewati tengah malam bila jamSelesai <= jamMulai.
model Shift {
  id                  String   @id @default(cuid())
  nama                String   @unique
  jamMulai            String   @map("jam_mulai")
  jamSelesai          String   @map("jam_selesai")
  toleransiTelatMenit Int      @default(15) @map("toleransi_telat_menit")
  aktif               Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  jadwal  Jadwal[]
  absensi Absensi[]
  rute    Rute[]

  @@map("Shift")
}

/// Jadwal jaga: satu shift per user per tanggal (F4-2).
/// `tanggal` disimpan sebagai DATE — kirim/tampilkan lewat helper WIB di lib/shift.ts.
model Jadwal {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  shiftId   String   @map("shift_id")
  tanggal   DateTime @db.Date
  /// Soft delete: false = jadwal dibatalkan/dikosongkan.
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([userId, tanggal])
  @@index([tanggal, shiftId])
  @@map("Jadwal")
}

/// Rute patroli + target putaran per shift (F4-3).
model Rute {
  id            String   @id @default(cuid())
  nama          String   @unique
  /// Null = rute cadangan untuk semua shift.
  shiftId       String?  @map("shift_id")
  targetPutaran Int      @default(1) @map("target_putaran")
  intervalMenit Int      @default(120) @map("interval_menit")
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shift Shift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  titik RuteTitik[]

  @@index([shiftId])
  @@map("Rute")
}

/// Urutan titik dalam satu rute.
model RuteTitik {
  id           String @id @default(cuid())
  ruteId       String @map("rute_id")
  checkpointId String @map("checkpoint_id")
  urutan       Int

  rute       Rute       @relation(fields: [ruteId], references: [id], onDelete: Cascade)
  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@unique([ruteId, checkpointId])
  @@unique([ruteId, urutan])
  @@map("RuteTitik")
}

/// Sesi login — token acak disimpan di cookie httpOnly.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Session")
}

/// Kategori laporan insiden (F4-4).
enum KategoriInsiden {
  KERUSAKAN
  TAMU_MENCURIGAKAN
  KEBAKARAN_ASAP
  KEHILANGAN
  LAINNYA
}

/// Prioritas insiden; DARURAT dipakai tombol darurat (F4-5).
enum PrioritasInsiden {
  RENDAH
  SEDANG
  TINGGI
  DARURAT
}

/// Alur status insiden: BARU -> DITANGANI -> SELESAI.
enum StatusInsiden {
  BARU
  DITANGANI
  SELESAI
}

/// Laporan insiden (F4-4) dan sinyal darurat (F4-5).
/// `fotoKeys` berisi key Foto (Cloudinary private), bukan gambar.
model Insiden {
  id                   String           @id @default(cuid())
  userId               String           @map("user_id")
  kategori             KategoriInsiden
  prioritas            PrioritasInsiden
  deskripsi            String
  fotoKeys             String[]         @map("foto_keys")
  lat                  Decimal?         @db.Decimal(10, 7)
  long                 Decimal?         @db.Decimal(10, 7)
  akurasiM             Int?             @map("akurasi_m")
  checkpointId         String?          @map("checkpoint_id")
  status               StatusInsiden    @default(BARU)
  ditanganiOleh        String?          @map("ditangani_oleh")
  ditanganiPada        DateTime?        @map("ditangani_pada")
  catatanTindakLanjut  String?          @map("catatan_tindak_lanjut")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  user       User        @relation("InsidenPelapor", fields: [userId], references: [id], onDelete: Cascade)
  penangan   User?       @relation("InsidenPenangan", fields: [ditanganiOleh], references: [id], onDelete: SetNull)
  checkpoint Checkpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  @@index([status, prioritas, createdAt])
  @@index([userId, createdAt])
  @@map("Insiden")
}
