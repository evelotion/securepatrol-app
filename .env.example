# Salin ke .env lalu isi. Jangan commit .env — hanya file contoh ini yang dilacak git.

# Database (Neon). Lokal & Preview = branch dev; Production = branch main.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Seed SUPER_ADMIN (password wajib minimal 12 karakter)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAMA=Administrator
SEED_ADMIN_PASSWORD=

# Cloudinary — server-side only; jangan beri prefix NEXT_PUBLIC_
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Validasi patroli (opsional; bawaan 100 m dan 50 m)
PATROL_RADIUS_M=100
PATROL_MAX_ACCURACY_M=50

# Cron harian penanda TIDAK_HADIR. Wajib di Vercel (Preview & Production);
# tanpa ini endpoint menolak semua permintaan.
CRON_SECRET=

# Belum dipakai (fitur ditunda): QR dinamis dan Web Push.
# QR_HMAC_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
